{
  "name": "sports-simulator",
  "displayName": "Sports Simulator",
  "description": "A football management sim that plays itself in your sidebar while you code.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "sports-simulator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigMoneyGreg/sports-simulator.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "football",
    "soccer",
    "sport",
    "sports",
    "manager",
    "league",
    "game",
    "idle",
    "simulation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "sportsSimulator.view",
          "name": "Sports Simulator"
        }
      ]
    },
    "commands": [
      {
        "command": "sportsSimulator.togglePause",
        "title": "Sports Simulator: Pause / Play"
      },
      {
        "command": "sportsSimulator.open",
        "title": "Sports Simulator: Open"
      },
      {
        "command": "sportsSimulator.resetCareer",
        "title": "Sports Simulator: Reset Career"
      }
    ],
    "configuration": {
      "title": "Sports Simulator",
      "properties": {
        "sportsSimulator.matchDuration": {
          "type": "string",
          "enum": [
            "30s",
            "2m",
            "5m"
          ],
          "enumDescriptions": [
            "30 seconds",
            "2 minutes",
            "5 minutes"
          ],
          "default": "2m",
          "description": "Real time one 90-minute match takes."
        },
        "sportsSimulator.fullTimeOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Show the full-time result over the Sports Simulator box for a few seconds after your match."
        },
        "sportsSimulator.statusBarScore": {
          "type": "boolean",
          "default": true,
          "description": "Show your live score in the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx tools/balance.ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "preview": "npm run build && tsx tools/preview.ts",
    "check-names": "tsx tools/check-names.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
