{
  "name": "sports-simulator",
  "displayName": "Sports Simulator",
  "description": "International football, rugby, cricket and Grand Prix racing sims that play themselves in your sidebar while you code: leagues, cups and world titles.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b5e3a",
    "theme": "dark"
  },
  "version": "0.1.0",
  "publisher": "bigdevgreg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigMoneyGreg/sports-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/BigMoneyGreg/sports-simulator/issues"
  },
  "homepage": "https://github.com/BigMoneyGreg/sports-simulator#readme",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "football",
    "soccer",
    "rugby",
    "cricket",
    "racing",
    "sport",
    "sports",
    "manager",
    "league",
    "international",
    "countries",
    "cup",
    "game",
    "idle",
    "simulation"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "sportsSimulator.view",
          "name": "Sports Simulator"
        }
      ]
    },
    "commands": [
      {
        "command": "sportsSimulator.togglePause",
        "title": "Sports Simulator: Pause / Play"
      },
      {
        "command": "sportsSimulator.open",
        "title": "Sports Simulator: Open"
      },
      {
        "command": "sportsSimulator.chooseSports",
        "title": "Sports Simulator: Choose Sports"
      },
      {
        "command": "sportsSimulator.switchSport",
        "title": "Sports Simulator: Switch Sport"
      }
    ],
    "configuration": {
      "title": "Sports Simulator",
      "properties": {
        "sportsSimulator.sports": {
          "type": "object",
          "scope": "application",
          "properties": {
            "football": {
              "type": "boolean",
              "default": true
            },
            "rugby": {
              "type": "boolean",
              "default": true
            },
            "cricket": {
              "type": "boolean",
              "default": true
            },
            "grandprix": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {
            "football": true,
            "rugby": true,
            "cricket": true,
            "grandprix": true
          },
          "description": "The sports to show. Hiding one with a career under way stops its clock and keeps the career, which carries on from the same moment when the sport is shown again. With none ticked, all of them show."
        },
        "sportsSimulator.showHonours": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "Show the Honours row in the box and a notification for each honour earned. Honours and records still count while this is off."
        },
        "sportsSimulator.speed": {
          "type": "string",
          "enum": [
            "normal",
            "fast",
            "fastest"
          ],
          "enumDescriptions": [
            "› A football match takes about 10 minutes",
            "›› About 3 minutes",
            "››› About 1 minute"
          ],
          "default": "normal",
          "description": "How fast every sport plays. Each match lasts its real length against the others: a rugby match a little shorter than a football one, a T20 match nearly twice as long. Also set from the › button beside the pause in the box."
        },
        "sportsSimulator.fullTimeOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Show the full-time result over the Sports Simulator box for a few seconds after your match."
        },
        "sportsSimulator.statusBarScore": {
          "type": "boolean",
          "default": true,
          "description": "Show your live score in the status bar. With several careers it shows each sport's week and league place in turn instead."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx tools/balance.ts",
    "balance:sports": "tsx tools/balance-sports.ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "preview": "npm run build && tsx tools/preview.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
