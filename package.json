{
  "name": "sports-simulator",
  "displayName": "Sports Simulator",
  "description": "International football, rugby and cricket sims that play themselves in your sidebar while you code: leagues, cups and a World Championship.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b5e3a",
    "theme": "dark"
  },
  "version": "0.1.0",
  "publisher": "bigdevgreg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigMoneyGreg/sports-simulator.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "football",
    "soccer",
    "rugby",
    "cricket",
    "sport",
    "sports",
    "manager",
    "league",
    "international",
    "countries",
    "cup",
    "game",
    "idle",
    "simulation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "sportsSimulator.view",
          "name": "Sports Simulator"
        }
      ]
    },
    "commands": [
      {
        "command": "sportsSimulator.togglePause",
        "title": "Sports Simulator: Pause / Play"
      },
      {
        "command": "sportsSimulator.open",
        "title": "Sports Simulator: Open"
      },
      {
        "command": "sportsSimulator.switchSport",
        "title": "Sports Simulator: Switch Sport"
      }
    ],
    "configuration": {
      "title": "Sports Simulator",
      "properties": {
        "sportsSimulator.matchDuration": {
          "type": "string",
          "enum": [
            "30s",
            "1m",
            "2m",
            "5m"
          ],
          "enumDescriptions": [
            "30 seconds (football only: a season takes about 25 minutes)",
            "1 minute (rugby only: a season takes about 20 minutes)",
            "2 minutes (a season takes about 1½ hours in football, 35 minutes in rugby, 25 minutes in cricket)",
            "5 minutes (a season takes about 3¾ hours in football, 1½ hours in rugby, 1 hour in cricket)"
          ],
          "default": "2m",
          "description": "Real time one match takes in a new career; a career under way keeps its own, set from the ⏱ button. If the sport doesn't offer this length, the next longer one is used."
        },
        "sportsSimulator.fullTimeOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Show the full-time result over the Sports Simulator box for a few seconds after your match."
        },
        "sportsSimulator.statusBarScore": {
          "type": "boolean",
          "default": true,
          "description": "Show your live score in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx tools/balance.ts",
    "balance:sports": "tsx tools/balance-sports.ts",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test:integration": "npm run build && node test/integration/run.mjs",
    "preview": "npm run build && tsx tools/preview.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
